{
  "allow": [
    "read(*)",
    "list(*)",
    "market(*)",
    "market:read",
    "document:read",
    "memory:read",
    "backtest:run",
    "agent(*)",
    "backtest(*)",
    "upload(document)",
    "alpha(*)"
